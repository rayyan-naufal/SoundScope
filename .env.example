# SoundScope - Environment Variables Example
# Copy this file to .env and set your keys

# Google Gemini API Key (Required for AI Tagging)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: ClickUp API Integration (for task/Kanban automation scripts)
CLICKUP_API_TOKEN=your_clickup_token_here
CLICKUP_DEFAULT_LIST_ID=your_list_id_here
